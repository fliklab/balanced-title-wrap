    "url": "git+https://github.com/fliklab/balanced-title-wrap.git",
    "directory": "packages/balanced-title-wrap"
  },
  "homepage": "https://balance-wrap-lab.jsh852.chatgpt.site",
  "bugs": {
    "url": "https://github.com/fliklab/balanced-title-wrap/issues"
  },
