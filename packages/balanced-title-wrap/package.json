{
  "name": "balanced-title-wrap",
  "version": "0.1.0",
  "description": "Fast, punctuation-aware balanced title wrapping for the web.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
